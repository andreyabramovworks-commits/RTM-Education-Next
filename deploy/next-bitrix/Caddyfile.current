http://62.109.6.159 {
	encode zstd gzip

	header {
		# This site is updated in place. Never allow browsers to combine assets
		# from two releases under a stale cache entry.
		Cache-Control "no-store, max-age=0, must-revalidate"
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https://images.unsplash.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; object-src 'none'"
	}

	# Preserve the requested preview URL for the current Goodwin release.
	@goodwinVersionPath path /21:52
	rewrite @goodwinVersionPath /

	reverse_proxy goodwin-static:80
}

rtm-app.ru, www.rtm-app.ru {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https://images.unsplash.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; object-src 'none'; upgrade-insecure-requests"
	}

	reverse_proxy goodwin-static:80
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# ELECTRONIC_ZRS
	handle /zrs/* {
		uri strip_prefix /zrs
		header {
			-X-Frame-Options
			Content-Security-Policy "frame-ancestors 'self' https://rtm-group.bitrix24.ru"
		}
		reverse_proxy electronic-zrs-web-1:80
	}

	# RTM_STATISTICS
	handle /statistics/* {
		uri strip_prefix /statistics
		header {
			-X-Frame-Options
			Content-Security-Policy "frame-ancestors 'self' https://rtm-group.bitrix24.ru"
		}
		reverse_proxy rtm-statistics-web-1:80
	}

	@bitrixApp path /bitrix/app /bitrix/app/
	handle @bitrixApp {
		header {
			-X-Frame-Options
			Content-Security-Policy "frame-ancestors 'self' https://rtm-group.bitrix24.ru"
		}
		method GET
		rewrite * /
		reverse_proxy frontend:80
	}

	@bitrixInstall path /bitrix/install /bitrix/install/
	handle @bitrixInstall {
		header {
			-X-Frame-Options
			Content-Security-Policy "frame-ancestors 'self' https://rtm-group.bitrix24.ru"
		}
		reverse_proxy backend:8000
	}

	handle /api/* {
		header X-Frame-Options "SAMEORIGIN"
		reverse_proxy backend:8000
	}

	# Finance service is hosted outside this Compose project.
	handle /finance-api/* {
		uri strip_prefix /finance-api
		reverse_proxy 172.18.0.1:18080
	}

	# Goodwin is a separate static project. This route is a temporary HTTPS preview
	# while the rtm-app.ru DNS record is moved to this server.
	@goodwinPreviewRoot path /goodwin
	redir @goodwinPreviewRoot /goodwin/ 308
	handle_path /goodwin/* {
		header {
			X-Frame-Options "DENY"
			Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https://images.unsplash.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; object-src 'none'"
		}
		reverse_proxy goodwin-static:80
	}

	handle {
		header {
			-X-Frame-Options
			Content-Security-Policy "frame-ancestors 'self' https://rtm-group.bitrix24.ru"
		}
		reverse_proxy frontend:80
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
